pipeline {
  agent any
  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }
    stage('Build') {
      steps {
        sh 'mvn clean package -DskipTests'
      }
    }
    stage('Archive') {
      steps {
        archiveArtifacts artifacts: 'target/*.jar, target/*.war', fingerprint: true
      }
    }
    stage('Deploy') {
      steps {
        sh 'cp target/*.war /opt/tomcat/webapps/ || true'
        sh 'cp target/*.jar /opt/tomcat/webapps/ || true'
      }
    }
  }
  post {
    success {
      echo 'Pipeline completed successfully'
    }
    failure {
      echo 'Pipeline failed'
    }
  }
}

